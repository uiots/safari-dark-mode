{
  "name": "safari-dark-mode",
  "version": "0.1.0",
  "private": true,
  "description": "A focused Safari 26 extension powered by Dark Reader's rendering engine.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "fixtures": "node scripts/fixture-server.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "darkreader": "github:darkreader/darkreader#v4.9.129"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/chrome": "0.1.1",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
